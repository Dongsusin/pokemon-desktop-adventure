{
  "name": "pokemon-desktop-adventure",
  "version": "0.34.0",
  "private": true,
  "description": "A Windows desktop Pokémon companion and idle adventure",
  "author": "Desktop Adventure",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
